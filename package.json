{
  "name": "juegos-jordan",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "find tests -name '*.test.js' ! -name 'navegador.test.js' -print0 | xargs -0 node --test",
    "test:browser": "node --test tests/navegador.test.js",
    "check": "find js tests -name '*.js' -print0 | xargs -0 -n1 node --check && npm run test:unit",
    "verificar-pages": "bash scripts/verificar-pages.sh",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
